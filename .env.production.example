# ─── ZentraBite production env template ─────────────────────────────────────
# Copy into Vercel → Project → Settings → Environment Variables (Production).
# Mark everything "Production" (and Preview if you want PR previews to work).
# Anything NEXT_PUBLIC_* is exposed to the browser — never paste secrets there.
# Add every value that isn't NEXT_PUBLIC_* as Sensitive (Vercel's Secret type), so
# nobody can read it back from the dashboard or the API.

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... # Supabase → Settings → API Keys → publishable key
SUPABASE_SECRET_KEY=sb_secret_...                      # Supabase → Settings → API Keys → secret key (server only, keep secret)
# Supabase's older JWT keys (anon and service_role) are switched off since
# 23 Nov 2026 and were removed from Vercel on 25 Nov. Don't add them back.

# ─── App URLs ───────────────────────────────────────────────────────────────
# zentrabite.com, never .com.au (we don't own zentrabite.com.au).
NEXT_PUBLIC_APP_URL=https://dashboard.zentrabite.com
NEXT_PUBLIC_MARKETING_URL=https://zentrabite.com

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                          # Stripe → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                        # Created when you add the webhook endpoint
STRIPE_PRICE_MERCHANT_MONTHLY=price_...                # The live monthly price ID, once Liam sets the price

# ─── Twilio (SMS) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+61...                             # Purchased AU number

# ─── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ZentraBite <orders@zentrabite.com>

# ─── Anthropic ──────────────────────────────────────────────────────────────
# On both projects. apps/web uses it for the website assistant (/api/ai-chat),
# apps/dashboard for the AI Copilot and the website import. Never expose it.
ANTHROPIC_API_KEY=sk-ant-api...

# ─── Cron ───────────────────────────────────────────────────────────────────
# Vercel passes this automatically in Authorization: Bearer <secret>
# Generate a long random string: `openssl rand -hex 32`
CRON_SECRET=change-me-to-a-long-random-string

# ─── Optional: delivery providers ───────────────────────────────────────────
# UBER_DIRECT_CLIENT_ID=...
# UBER_DIRECT_CLIENT_SECRET=...
# DOORDASH_DEVELOPER_ID=...
# DOORDASH_KEY_ID=...
# DOORDASH_SIGNING_SECRET=...
